{
  "name": "minimart-pos-rebuilt",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions --project demo-minimart-staging",
    "setup:emulators": "firebase setup:emulators:firestore",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "check:security": "node scripts/security-preflight.mjs",
    "check:staging": "node scripts/verify-staging-config.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-minimart-pos-security \"node --test tests/firestore.rules.test.mjs\"",
    "test:sync": "node scripts/test-sync-safety.mjs",
    "test:cash": "node scripts/test-cashier-cash.mjs",
    "test:qr": "node scripts/test-kpay-qr.mjs",
    "test:cursor": "node scripts/test-cashier-sync-cursor.mjs",
    "test:overview": "node scripts/test-branch-overview.mjs",
    "test:runtime": "node scripts/test-firebase-runtime.mjs",
    "test:statement": "node scripts/test-customer-statement.mjs",
    "test:checkout": "node scripts/test-pos-checkout.mjs",
    "test:store": "node scripts/test-pos-store-inventory.mjs",
    "test:units": "node scripts/test-pos-unit-tracking.mjs",
    "test:transfer": "node scripts/test-pos-branch-transfer.mjs",
    "test:unit-sale-server": "node scripts/test-cashier-unit-sale-server.mjs",
    "test:sale-adjustments-server": "node scripts/test-sale-adjustments-server.mjs",
    "test:offline": "node scripts/test-offline-reconciliation.mjs",
    "test:worker-client": "node scripts/test-worker-client.mjs",
    "test:backup": "firebase emulators:exec --only firestore --project demo-minimart-backup \"node scripts/test-firestore-backup.mjs\"",
    "test:server": "firebase emulators:exec --only auth,firestore,functions --project demo-minimart-staging \"node scripts/test-cashier-unit-sale-server.mjs && node scripts/test-sale-adjustments-server.mjs\"",
    "report:bundle": "node scripts/bundle-report.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:quick": "node scripts/qa.mjs --skip-rules"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.26.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
