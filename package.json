{
  "name": "minimart-pos-rebuilt",
  "private": true,
  "version": "3.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "check:security": "node scripts/security-preflight.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-minimart-pos-security \"node --test tests/firestore.rules.test.mjs\"",
    "report:bundle": "node scripts/bundle-report.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:quick": "node scripts/qa.mjs --skip-rules"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.26.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
