rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap permission is limited to creating the first fixed Business
    // document. It must never grant ongoing Owner access to branches, members,
    // products, finance, or shared data. Ongoing Owner access is based only on
    // businesses/{businessId}.ownerUid.
    function isInitialBusinessBootstrapper(businessId) {
      return signedIn()
        && businessId == 'store-mini-main'
        && request.auth.uid == 'LjZX15uSeehtIbyL4SqO1HcyLyC2';
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }

    function branchPath(businessId, branchId) {
      return /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId);
    }

    function salePath(businessId, branchId, saleId) {
      return /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/sales/$(saleId);
    }

    function isBusinessOwner(businessId) {
      // Keep the authentication check before any Rules document lookup so
      // anonymous requests do not trigger unnecessary dependent reads.
      return signedIn()
        && exists(businessPath(businessId))
        && get(businessPath(businessId)).data.ownerUid == request.auth.uid
        && get(businessPath(businessId)).data.get('active', true) != false;
    }

    function isOwner(businessId) {
      // Never use the bootstrap UID as a permanent Owner fallback.
      return isBusinessOwner(businessId);
    }

    function isActiveBranch(businessId, branchId) {
      let path = branchPath(businessId, branchId);
      // Check existence before reading fields so a missing Branch is a clean
      // deny rather than a null-value Rules evaluation error.
      return exists(path)
        && get(path).data.payload is map
        && get(path).data.payload.status == 'active';
    }

    function isCashierAssignedToBranch(businessId, branchId) {
      // Avoid a dependent Member lookup until the request is authenticated.
      return signedIn()
        && request.auth.token.email is string
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && get(memberPath(businessId, request.auth.uid)).data.email == request.auth.token.email
        && get(memberPath(businessId, request.auth.uid)).data.status == 'active'
        && get(memberPath(businessId, request.auth.uid)).data.role == 'cashier'
        && get(memberPath(businessId, request.auth.uid)).data.branchIds is list
        && get(memberPath(businessId, request.auth.uid)).data.branchIds.size() == 1
        && get(memberPath(businessId, request.auth.uid)).data.branchIds[0] is string
        && get(memberPath(businessId, request.auth.uid)).data.branchIds[0] == branchId;
    }

    function isActiveMember(businessId) {
      // Email, UID, role, status and the one active Branch are all checked.
      // Short-circuiting keeps unauthenticated requests from reading the Member.
      return signedIn()
        && request.auth.token.email is string
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && get(memberPath(businessId, request.auth.uid)).data.email == request.auth.token.email
        && get(memberPath(businessId, request.auth.uid)).data.role == 'cashier'
        && get(memberPath(businessId, request.auth.uid)).data.status == 'active'
        && get(memberPath(businessId, request.auth.uid)).data.branchIds is list
        && get(memberPath(businessId, request.auth.uid)).data.branchIds.size() == 1
        && get(memberPath(businessId, request.auth.uid)).data.branchIds[0] is string
        && isActiveBranch(businessId, get(memberPath(businessId, request.auth.uid)).data.branchIds[0]);
    }

    function isCashierForBranch(businessId, branchId) {
      return isCashierAssignedToBranch(businessId, branchId)
        && isActiveBranch(businessId, branchId);
    }

    function branchHasConfiguredKPay(businessId, branchId) {
      let branchDoc = get(branchPath(businessId, branchId));
      return branchDoc != null
        && branchDoc.data.payload is map
        && branchDoc.data.payload.settings is map
        && branchDoc.data.payload.settings.kpayAccountName is string
        && branchDoc.data.payload.settings.kpayAccountName.size() > 0
        && branchDoc.data.payload.settings.kpayAccountNumber is string
        && branchDoc.data.payload.settings.kpayAccountNumber.size() > 0;
    }

    function isStockReceiverForBranch(businessId, branchId) {
      return isCashierForBranch(businessId, branchId)
        && get(memberPath(businessId, request.auth.uid)).data.canReceiveStock == true;
    }

    // A receiver may only acknowledge a dispatched shipment addressed to their
    // one assigned branch. This update cannot change Product or Stock documents.
    function validStockShipmentReceiptUpdate(businessId, branchId) {
      return isStockReceiverForBranch(businessId, branchId)
        && resource.data.scope == 'branchRecord'
        && resource.data.kind == 'stockShipments'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload is map
        && resource.data.payload.status == 'dispatched'
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockShipments'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'status', 'receivedItems', 'receivedAt', 'receivedByUid', 'receivedByEmail', 'receivedByName', 'receiverNote'
        ])
        && request.resource.data.payload.status == 'received'
        && request.resource.data.payload.toBranchId == branchId
        && request.resource.data.payload.receivedByUid == request.auth.uid
        && request.resource.data.payload.receivedAt is string
        && request.resource.data.payload.receivedItems is list
        && request.resource.data.payload.receivedItems.size() == resource.data.payload.items.size();
    }

    function validCashierSaleAuditCreate(businessId, branchId, eventId) {
      let saleId = request.resource.data.saleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let afterSale = getAfter(linkedSale);
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'id', 'eventType', 'branchId', 'saleId', 'receiptNo', 'actorUid',
          'actorEmail', 'actorName', 'occurredAt', 'total'
        ])
        && request.resource.data.id == eventId
        && eventId == request.resource.data.saleId + '__created'
        && request.resource.data.eventType == 'SALE_CREATED'
        && request.resource.data.branchId == branchId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.saleId is string
        && request.resource.data.receiptNo is string
        && request.resource.data.occurredAt is string
        && request.resource.data.total is number
        && !exists(linkedSale)
        && afterSale != null
        && afterSale.data.kind == 'sales'
        && afterSale.data.branchId == branchId
        && afterSale.data.payload.createdByUid == request.auth.uid
        && afterSale.data.payload.status == 'completed';
    }

    function validOwnerVoidAuditCreate(businessId, branchId, eventId) {
      let linkedSale = salePath(businessId, branchId, request.resource.data.saleId);
      let afterSale = getAfter(linkedSale);
      return isOwner(businessId)
        && request.resource.data.keys().hasOnly([
          'id', 'eventType', 'branchId', 'saleId', 'receiptNo', 'actorUid',
          'actorEmail', 'actorName', 'occurredAt', 'total', 'reason'
        ])
        && request.resource.data.id == eventId
        && eventId == request.resource.data.saleId + '__void'
        && request.resource.data.eventType == 'SALE_VOIDED'
        && request.resource.data.branchId == branchId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && exists(linkedSale)
        && afterSale != null
        && afterSale.data.payload.status == 'voided'
        && afterSale.data.payload.voidedByUid == request.auth.uid
        && afterSale.data.payload.voidReason == request.resource.data.reason;
    }

    function validCashierMember(businessId, memberId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'branchIds',
          'status', 'createdAt', 'updatedAt', 'createdBy', 'canReceiveStock'
        ])
        && request.resource.data.uid == memberId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'cashier'
        && request.resource.data.status == 'active'
        && request.resource.data.branchIds is list
        && request.resource.data.branchIds.size() == 1
        && request.resource.data.branchIds[0] is string
        && isActiveBranch(businessId, request.resource.data.branchIds[0])
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['canReceiveStock']) || request.resource.data.canReceiveStock is bool);
    }

    function validCashierSaleCreate(businessId, branchId, saleId) {
      let payload = request.resource.data.payload;
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'deleted', 'updatedAt', 'updatedBy', 'payload'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'sales'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && payload is map
        && payload.id == saleId
        && payload.branchId == branchId
        && payload.createdByUid == request.auth.uid
        && payload.status == 'completed'
        && payload.receiptNo is string
        && payload.items is list
        && payload.items.size() > 0
        && payload.total is number
        && payload.total >= 0
        && payload.paymentMethod in ['Cash', 'KPay', 'Credit']
        && (payload.paymentMethod != 'KPay'
          || (payload.kpayTransactionReference is string
            && payload.kpayTransactionReference.size() > 0
            && branchHasConfiguredKPay(businessId, branchId)))
        && payload.productDeltas is map
        && payload.productDeltas.keys().size() > 0
        && payload.stockLines is list
        && payload.stockLines.size() == payload.productDeltas.keys().size()
        && (
          (payload.cashierSyncVersion == 1
            && (!payload.keys().hasAny(['batchDeltas']) || payload.batchDeltas is map)
            && (!payload.keys().hasAny(['batchLines']) || payload.batchLines is list))
          || (payload.cashierSyncVersion == 2
            && payload.batchDeltas is map
            && payload.batchDeltas.keys().size() >= payload.productDeltas.keys().size()
            && payload.batchLines is list
            && payload.batchLines.size() == payload.batchDeltas.keys().size())
        );
    }

    // Allows a Cashier to flag their own completed sale with a Void Request for the Owner.
    function validCashierSaleVoidRequest(businessId, branchId) {
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'sales'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload.createdByUid == request.auth.uid
        && resource.data.payload.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'voidRequested', 'voidRequestReason', 'voidRequestedAt', 'voidRequestedByUid', 'voidRequestedByName'
        ])
        && request.resource.data.payload.voidRequested == true
        && request.resource.data.payload.voidRequestReason is string
        && request.resource.data.payload.voidRequestReason.size() >= 2;
    }

    // Allows a Cashier to record a Customer Credit payment on an open Credit invoice.
    function validCashierCreditSalePaymentUpdate(businessId, branchId) {
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'sales'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload.paymentMethod == 'Credit'
        && resource.data.payload.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['paidAmount', 'dueAmount'])
        && request.resource.data.payload.paidAmount is number
        && request.resource.data.payload.dueAmount is number
        && request.resource.data.payload.paidAmount >= 0
        && request.resource.data.payload.dueAmount >= 0;
    }

    function validCashierExpenseCreate(businessId, branchId, expenseId) {
      let payload = request.resource.data.payload;
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'deleted', 'updatedAt', 'updatedBy', 'payload'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'expenses'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && payload is map
        && payload.keys().hasOnly([
          'id', 'branchId', 'title', 'category', 'amount', 'date', 'note',
          'createdByUid', 'createdByEmail', 'createdByName', 'createdByRole', 'fundedBy',
          'paymentMethod', 'approvalStatus', 'reviewStatus', 'submittedAt',
          'updatedAt', 'updatedByUid'
        ])
        && payload.id == expenseId
        && payload.branchId == branchId
        && payload.title is string
        && payload.title.size() > 0
        && payload.category is string
        && payload.amount is number
        && payload.amount > 0
        && payload.date is string
        && payload.note is string
        && payload.createdByUid == request.auth.uid
        && payload.createdByEmail is string
        && payload.createdByName is string
        && (!payload.keys().hasAny(['createdByRole']) || payload.createdByRole == 'cashier')
        && payload.fundedBy in ['cashier-personal', 'branch-cash', 'branch-kpay']
        && payload.paymentMethod in ['cash', 'kpay']
        && (payload.fundedBy != 'branch-cash' || payload.paymentMethod == 'cash')
        && (payload.fundedBy != 'branch-kpay' || payload.paymentMethod == 'kpay')
        && payload.approvalStatus in ['pending', 'not-required']
        && (!payload.keys().hasAny(['reviewStatus']) || payload.reviewStatus == 'submitted')
        && (!payload.keys().hasAny(['submittedAt']) || payload.submittedAt is string)
        && payload.updatedAt is string
        && payload.updatedByUid == request.auth.uid;
    }

    function validCashierBranchRecordWrite(businessId, branchId, collectionName, recordId) {
      let payload = request.resource.data.payload;
      return isCashierForBranch(businessId, branchId)
        && collectionName in ['cashShifts', 'cashMovements', 'customerPayments']
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == collectionName
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && payload is map
        && payload.id == recordId
        && payload.branchId == branchId;
    }

    function linkedProductStockReduction(businessId, branchId, productId) {
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let afterSale = getAfter(linkedSale);
      let reduction = resource.data.payload.stock - request.resource.data.payload.stock;
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'products'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'products'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['stock'])
        && resource.data.payload.stock is number
        && request.resource.data.payload.stock is number
        && reduction > 0
        && request.resource.data.payload.stock >= 0
        && !exists(linkedSale)
        && afterSale != null
        && afterSale.data.kind == 'sales'
        && afterSale.data.branchId == branchId
        && afterSale.data.updatedBy == request.auth.uid
        && afterSale.data.payload.createdByUid == request.auth.uid
        && afterSale.data.payload.status == 'completed'
        && afterSale.data.payload.productDeltas[productId] == reduction
        && afterSale.data.payload.stockLines is list
        && afterSale.data.payload.stockLines.hasAny([{'productId': productId, 'quantity': reduction}]);
    }

    function linkedBatchStockReduction(businessId, branchId, batchId) {
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let afterSale = getAfter(linkedSale);
      let reduction = resource.data.payload.quantity - request.resource.data.payload.quantity;
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'stockBatches'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockBatches'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['quantity'])
        && resource.data.payload.quantity is number
        && request.resource.data.payload.quantity is number
        && reduction > 0
        && request.resource.data.payload.quantity >= 0
        && !exists(linkedSale)
        && afterSale != null
        && afterSale.data.kind == 'sales'
        && afterSale.data.branchId == branchId
        && afterSale.data.updatedBy == request.auth.uid
        && afterSale.data.payload.createdByUid == request.auth.uid
        && afterSale.data.payload.status == 'completed'
        && afterSale.data.payload.batchDeltas[batchId] == reduction
        && afterSale.data.payload.batchLines is list
        && afterSale.data.payload.batchLines.hasAny([{
          'batchId': batchId,
          'productId': resource.data.payload.productId,
          'quantity': reduction
        }]);
    }

    function sharedPriceGroupPath(businessId, groupId) {
      return /databases/$(database)/documents/businesses/$(businessId)/shared/priceGroups/records/$(groupId);
    }

    function validSharedPriceGroupWrite(recordId) {
      let payload = request.resource.data.payload;
      return request.resource.data.keys().hasOnly(['scope', 'kind', 'payload', 'deleted', 'updatedAt', 'updatedBy'])
        && request.resource.data.scope == 'shared'
        && request.resource.data.kind == 'priceGroups'
        && request.resource.data.deleted == false
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && payload is map
        && payload.keys().hasAll(['id', 'name', 'retailPrice', 'wholesalePrice', 'currency', 'version', 'status', 'membersByBranch', 'createdAt', 'updatedAt'])
        && payload.keys().hasOnly(['id', 'name', 'retailPrice', 'wholesalePrice', 'currency', 'version', 'status', 'membersByBranch', 'createdAt', 'updatedAt', 'updatedByUid'])
        && payload.id == recordId
        && payload.name is string
        && payload.name.size() > 0
        && payload.name.size() <= 120
        && payload.retailPrice is number
        && payload.retailPrice > 0
        && payload.wholesalePrice is number
        && payload.wholesalePrice >= 0
        && payload.currency == 'MMK'
        && payload.version is int
        && payload.version >= 1
        && payload.status in ['active', 'archived']
        && payload.membersByBranch is map
        && ((payload.status == 'active' && payload.membersByBranch.keys().size() >= 2)
          || (payload.status == 'archived' && payload.membersByBranch.keys().size() == 0))
        && payload.createdAt is string
        && payload.updatedAt is string
        && (!('updatedByUid' in payload) || payload.updatedByUid == request.auth.uid);
    }

    // Only validate the group document when a Product's shared-price fields change.
    // Ordinary stock/cost updates therefore do not add an extra Rules document lookup.
    function validProductSharedPriceMirror(businessId, branchId, recordId) {
      let payload = request.resource.data.payload;
      let groupPath = sharedPriceGroupPath(businessId, payload.priceGroupId);
      let group = getAfter(groupPath).data;
      return payload.priceGroupId is string
        && payload.priceVersion is int
        && existsAfter(groupPath)
        && group.deleted == false
        && group.scope == 'shared'
        && group.kind == 'priceGroups'
        && group.payload.id == payload.priceGroupId
        && group.payload.status == 'active'
        && group.payload.membersByBranch[branchId] == recordId
        && group.payload.retailPrice == payload.retailPrice
        && group.payload.wholesalePrice == payload.wholesalePrice
        && group.payload.version == payload.priceVersion;
    }

    function validProductSharedPriceUnlink(businessId, branchId, recordId) {
      let oldGroupId = resource.data.payload.priceGroupId;
      let groupPath = sharedPriceGroupPath(businessId, oldGroupId);
      let group = getAfter(groupPath).data;
      let oldPayload = resource.data.payload;
      let nextPayload = request.resource.data.payload;
      return oldGroupId is string
        && existsAfter(groupPath)
        && group.scope == 'shared'
        && group.kind == 'priceGroups'
        && !(branchId in group.payload.membersByBranch.keys())
        // Unlink retains the last shared selling price as the new standalone price.
        && nextPayload.retailPrice == oldPayload.retailPrice
        && nextPayload.wholesalePrice == oldPayload.wholesalePrice
        && !('priceVersion' in nextPayload);
    }

    function validProductSharedPriceUpdate(businessId, branchId, recordId) {
      let nextPayload = request.resource.data.payload;
      let oldPayload = resource.data.payload;
      let priceFieldsChanged = nextPayload.diff(oldPayload).affectedKeys().hasAny(['priceGroupId', 'priceVersion', 'retailPrice', 'wholesalePrice']);
      return !priceFieldsChanged
        || ('priceGroupId' in nextPayload
          && validProductSharedPriceMirror(businessId, branchId, recordId)
          && (!('priceGroupId' in oldPayload) || oldPayload.priceGroupId == nextPayload.priceGroupId
            || validProductSharedPriceUnlink(businessId, branchId, recordId)))
        || (!('priceGroupId' in nextPayload)
          && (!('priceGroupId' in oldPayload) || validProductSharedPriceUnlink(businessId, branchId, recordId)));
    }

    function validProductSharedPriceCreate(businessId, branchId, recordId) {
      return !('priceGroupId' in request.resource.data.payload)
        || validProductSharedPriceMirror(businessId, branchId, recordId);
    }

    function validLinkedProductDelete(businessId, branchId, recordId) {
      return !('priceGroupId' in resource.data.payload)
        || validProductSharedPriceUnlink(businessId, branchId, recordId);
    }

    function validCashierCustomerCreate(businessId, recordId) {
      let branchId = request.resource.data.branchId;
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let afterSale = getAfter(linkedSale);
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.scope == 'shared'
        && request.resource.data.kind == 'customers'
        && request.resource.data.payload is map
        && request.resource.data.payload.id == recordId
        && request.resource.data.updatedBy == request.auth.uid
        && (
          !(request.resource.data.keys().hasAny(['sourceSaleId']))
          || (
            request.resource.data.sourceSaleId is string
            && !exists(linkedSale)
            && afterSale != null
            && afterSale.data.kind == 'sales'
            && afterSale.data.updatedBy == request.auth.uid
            && afterSale.data.payload.createdByUid == request.auth.uid
            && afterSale.data.payload.paymentMethod == 'Credit'
            && afterSale.data.payload.customerId == recordId
          )
        );
    }

    match /businesses/{businessId} {
      allow get: if isOwner(businessId) || isActiveMember(businessId);
      allow list: if false;

      // This production workspace is pre-provisioned. The pinned bootstrap UID
      // may initialize only the fixed Business document. After creation, all
      // Owner access is derived exclusively from the immutable ownerUid field.
      allow create: if isInitialBusinessBootstrapper(businessId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
      allow update: if isOwner(businessId)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{memberId} {
        allow get: if (signedIn() && request.auth.uid == memberId) || isOwner(businessId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && validCashierMember(businessId, memberId);
        allow update: if isOwner(businessId)
          && resource.data.role == 'cashier'
          && request.resource.data.role == 'cashier'
          && request.resource.data.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'branchIds', 'status', 'updatedAt', 'canReceiveStock'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['canReceiveStock']) || request.resource.data.canReceiveStock is bool)
          && request.resource.data.branchIds is list
          && request.resource.data.branchIds.size() == 1
          && request.resource.data.branchIds[0] is string
          && isActiveBranch(businessId, request.resource.data.branchIds[0])
          && request.resource.data.status in ['active', 'disabled'];
        allow delete: if isOwner(businessId) && resource.data.role == 'cashier';
      }

      match /branches/{branchId} {
        allow get: if isOwner(businessId)
          || (isCashierAssignedToBranch(businessId, branchId)
            && resource.data.payload is map
            && resource.data.payload.status == 'active');
        allow list: if isOwner(businessId);
        allow create, update, delete: if isOwner(businessId);

        match /{collectionName}/{recordId} {
          allow get: if isOwner(businessId)
            || (isCashierForBranch(businessId, branchId)
              && (collectionName in ['categories', 'products', 'stockBatches', 'cashShifts', 'cashMovements', 'customerPayments']
                || (collectionName == 'stockShipments' && isStockReceiverForBranch(businessId, branchId))
                || (collectionName == 'expenses'
                  && (!exists(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/expenses/$(recordId))
                    || resource.data.payload.createdByUid == request.auth.uid))
                || (collectionName == 'cashierSettlements'
                  && resource.data.payload.cashierUid == request.auth.uid)
                || (collectionName == 'sales'
                  && (!exists(salePath(businessId, branchId, recordId))
                    || resource.data.payload.branchId == branchId))
                || (collectionName == 'auditEvents'
                  && (!exists(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/auditEvents/$(recordId))
                    || resource.data.actorUid == request.auth.uid))));

          allow list: if isOwner(businessId)
            || (isCashierForBranch(businessId, branchId)
              && (collectionName in ['categories', 'products', 'stockBatches', 'cashShifts', 'cashMovements', 'customerPayments']
                || (collectionName == 'stockShipments' && isStockReceiverForBranch(businessId, branchId))
                || (collectionName == 'expenses'
                  && request.query.limit <= 500
                  && resource.data.payload.createdByUid == request.auth.uid)
                || (collectionName == 'cashierSettlements'
                  && request.query.limit <= 500
                  && resource.data.payload.cashierUid == request.auth.uid)
                || (collectionName == 'sales'
                  && request.query.limit <= 500
                  && resource.data.payload.createdByUid == request.auth.uid)));

          allow create: if (isOwner(businessId) && collectionName != 'auditEvents'
              && (collectionName != 'products' || validProductSharedPriceCreate(businessId, branchId, recordId)))
            || (collectionName == 'sales' && validCashierSaleCreate(businessId, branchId, recordId))
            || (collectionName == 'expenses' && validCashierExpenseCreate(businessId, branchId, recordId))
            || validCashierBranchRecordWrite(businessId, branchId, collectionName, recordId)
            || (collectionName == 'auditEvents' && (validCashierSaleAuditCreate(businessId, branchId, recordId)
              || validOwnerVoidAuditCreate(businessId, branchId, recordId)));

          allow update: if (isOwner(businessId) && collectionName != 'auditEvents' && collectionName != 'branchFinanceReconciliations'
              && (collectionName != 'products' || validProductSharedPriceUpdate(businessId, branchId, recordId)))
            || (collectionName == 'stockShipments' && validStockShipmentReceiptUpdate(businessId, branchId))
            || (collectionName == 'products' && linkedProductStockReduction(businessId, branchId, recordId))
            || (collectionName == 'stockBatches' && linkedBatchStockReduction(businessId, branchId, recordId))
            || (collectionName == 'sales' && (validCashierSaleVoidRequest(businessId, branchId) || validCashierCreditSalePaymentUpdate(businessId, branchId)))
            || (collectionName == 'cashShifts' && validCashierBranchRecordWrite(businessId, branchId, collectionName, recordId));

          allow delete: if isOwner(businessId) && collectionName != 'auditEvents' && collectionName != 'branchFinanceReconciliations'
            && (collectionName != 'products' || validLinkedProductDelete(businessId, branchId, recordId));
        }
      }

      match /shared/{collectionName}/{recordId} {
        allow read, write: if isOwner(businessId);
      }

      match /shared/{collectionName}/records/{recordId} {
        // Price Group master records are Owner-only. Cashiers receive the effective
        // retail/wholesale price through their assigned Branch Product documents.
        allow get: if isOwner(businessId)
          || (collectionName != 'priceGroups' && isActiveMember(businessId));
        allow list: if isOwner(businessId) || (isActiveMember(businessId) && collectionName == 'customers');
        allow create: if (isOwner(businessId)
            && (collectionName != 'priceGroups' || validSharedPriceGroupWrite(recordId)))
          || (collectionName == 'customers' && validCashierCustomerCreate(businessId, recordId));
        allow update: if isOwner(businessId)
          && (collectionName != 'priceGroups' || validSharedPriceGroupWrite(recordId));
        allow delete: if isOwner(businessId) && collectionName != 'priceGroups';
      }

      match /meta/{metaId} {
        allow read, write: if isOwner(businessId);
      }
    }

    // Per-user legacy POS data remains private to its authenticated user.
    match /posAccounts/{userId}/posRecords/{recordId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /posAccounts/{userId}/posMeta/{metaId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // All unspecified paths remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
