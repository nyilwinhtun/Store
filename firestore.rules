rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Dedicated Minimart Production project. Keep the configured Owner UID pinned.
    function isConfiguredOwner(businessId) {
      return signedIn()
        && businessId == 'store-mini-main'
        && request.auth.uid == 'LjZX15uSeehtIbyL4SqO1HcyLyC2';
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }

    function branchPath(businessId, branchId) {
      return /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId);
    }

    function salePath(businessId, branchId, saleId) {
      return /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/sales/$(saleId);
    }
    function isBusinessOwner(businessId) {
      return isConfiguredOwner(businessId)
        && exists(businessPath(businessId))
        && get(businessPath(businessId)).data.ownerUid == request.auth.uid
        && get(businessPath(businessId)).data.active != false;
    }

    function isOwner(businessId) {
      return isBusinessOwner(businessId);
    }

    function isActiveMember(businessId) {
      return signedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && get(memberPath(businessId, request.auth.uid)).data.status == 'active';
    }

    function isCashierForBranch(businessId, branchId) {
      return isActiveMember(businessId)
        && get(memberPath(businessId, request.auth.uid)).data.role == 'cashier'
        && get(memberPath(businessId, request.auth.uid)).data.branchIds is list
        && get(memberPath(businessId, request.auth.uid)).data.branchIds.size() == 1
        && get(memberPath(businessId, request.auth.uid)).data.branchIds[0] == branchId;
    }


    function branchHasConfiguredKPay(businessId, branchId) {
      return exists(branchPath(businessId, branchId))
        && get(branchPath(businessId, branchId)).data.payload is map
        && get(branchPath(businessId, branchId)).data.payload.settings is map
        && get(branchPath(businessId, branchId)).data.payload.settings.kpayAccountName is string
        && get(branchPath(businessId, branchId)).data.payload.settings.kpayAccountName.size() > 0
        && get(branchPath(businessId, branchId)).data.payload.settings.kpayAccountNumber is string
        && get(branchPath(businessId, branchId)).data.payload.settings.kpayAccountNumber.size() > 0;
    }

    function isStockReceiverForBranch(businessId, branchId) {
      return isCashierForBranch(businessId, branchId)
        && get(memberPath(businessId, request.auth.uid)).data.canReceiveStock == true;
    }

    // A receiver may only acknowledge a dispatched shipment addressed to their
    // one assigned branch. This update cannot change Product or Stock documents.
    function validStockShipmentReceiptUpdate(businessId, branchId) {
      return isStockReceiverForBranch(businessId, branchId)
        && resource.data.scope == 'branchRecord'
        && resource.data.kind == 'stockShipments'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload is map
        && resource.data.payload.status == 'dispatched'
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockShipments'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'status', 'receivedItems', 'receivedAt', 'receivedByUid', 'receivedByEmail', 'receivedByName', 'receiverNote'
        ])
        && request.resource.data.payload.status == 'received'
        && request.resource.data.payload.toBranchId == branchId
        && request.resource.data.payload.receivedByUid == request.auth.uid
        && request.resource.data.payload.receivedAt is string
        && request.resource.data.payload.receivedItems is list
        && request.resource.data.payload.receivedItems.size() == resource.data.payload.items.size();
    }

    // Exact-match Branch Shipment completion is restricted to a receiver assigned
    // to the destination branch. Product/Batch writes must reference the same
    // approved shipment and a specific immutable line/allocation in that shipment.
    function validStockShipmentAutoCompleteUpdate(businessId, branchId) {
      let payload = request.resource.data.payload;
      return isStockReceiverForBranch(businessId, branchId)
        && resource.data.scope == 'branchRecord'
        && resource.data.kind == 'stockShipments'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload is map
        && resource.data.payload.status == 'dispatched'
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockShipments'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'status', 'receivedAt', 'receivedByUid', 'receivedByEmail', 'receivedByName', 'receiverNote',
          'receivedItems', 'approvedAt', 'approvedByUid', 'approvedByEmail', 'approvedByName',
          'approvalNote', 'completionMode', 'autoCompletedAt', 'autoCompletedByUid', 'autoCompletionPlan'
        ])
        && payload.status == 'approved'
        && payload.toBranchId == branchId
        && payload.completionMode == 'auto'
        && payload.autoCompletedByUid == request.auth.uid
        && payload.autoCompletedAt is string
        && payload.receivedByUid == request.auth.uid
        && payload.receivedAt is string
        && payload.approvedByUid == request.auth.uid
        && payload.approvedAt is string
        && payload.items == resource.data.payload.items
        && payload.items is list
        && payload.items.size() > 0
        && payload.items.size() <= 50
        && payload.receivedItems is list
        && payload.receivedItems.size() == payload.items.size()
        && payload.autoCompletionPlan is list
        && payload.autoCompletionPlan.size() == payload.items.size();
    }

    function validStockShipmentProductCreate(businessId, branchId, productId) {
      let shipmentId = request.resource.data.sourceShipmentId;
      let lineIndex = request.resource.data.sourceShipmentLineIndex;
      let shipmentPath = /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/stockShipments/$(shipmentId);
      let shipment = getAfter(shipmentPath).data;
      let payload = shipment.payload;
      let line = payload.items[lineIndex];
      let receipt = payload.receivedItems[lineIndex];
      let plan = payload.autoCompletionPlan[lineIndex];
      let product = request.resource.data.payload;
      return isStockReceiverForBranch(businessId, branchId)
        && shipmentId is string
        && lineIndex is int
        && existsAfter(shipmentPath)
        && shipment.kind == 'stockShipments'
        && shipment.branchId == branchId
        && payload.status == 'approved'
        && payload.completionMode == 'auto'
        && payload.autoCompletedByUid == request.auth.uid
        && payload.toBranchId == branchId
        && lineIndex >= 0 && lineIndex < payload.items.size()
        && line.sourceProductId == receipt.sourceProductId
        && plan.sourceProductId == line.sourceProductId
        && plan.destinationProductId == productId
        && plan.destinationStockBefore == 0
        && plan.destinationStockAfter >= line.quantity - 0.000001
        && plan.destinationStockAfter <= line.quantity + 0.000001
        && plan.destinationBatchIds is list
        && plan.destinationBatchIds.size() == line.batchAllocations.size()
        && receipt.receivedQuantity == line.quantity
        && receipt.damagedQuantity == 0
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'payload', 'deleted', 'updatedAt', 'updatedBy',
          'sourceShipmentId', 'sourceShipmentLineIndex'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'products'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceShipmentId == shipmentId
        && request.resource.data.sourceShipmentLineIndex == lineIndex
        && product is map
        && product.id == productId
        && product.branchId == branchId
        && product.stock == line.quantity
        && product.name == line.productName
        && product.sku == line.sku
        && product.barcode == line.barcode
        && product.costPrice == line.costPrice
        && product.retailPrice == line.retailPrice
        && product.wholesalePrice == line.wholesalePrice
        && product.lowStockAt == line.lowStockAt
        && product.unit == line.unit
        && product.quantityMode == line.quantityMode;
    }

    function validStockShipmentProductUpdate(businessId, branchId, productId) {
      let shipmentId = request.resource.data.sourceShipmentId;
      let lineIndex = request.resource.data.sourceShipmentLineIndex;
      let shipmentPath = /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/stockShipments/$(shipmentId);
      let shipment = getAfter(shipmentPath).data;
      let payload = shipment.payload;
      let line = payload.items[lineIndex];
      let receipt = payload.receivedItems[lineIndex];
      let plan = payload.autoCompletionPlan[lineIndex];
      let product = request.resource.data.payload;
      let previous = resource.data.payload;
      return isStockReceiverForBranch(businessId, branchId)
        && resource.data.scope == 'branchRecord'
        && resource.data.kind == 'products'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && shipmentId is string
        && lineIndex is int
        && existsAfter(shipmentPath)
        && shipment.kind == 'stockShipments'
        && shipment.branchId == branchId
        && payload.status == 'approved'
        && payload.completionMode == 'auto'
        && payload.autoCompletedByUid == request.auth.uid
        && payload.toBranchId == branchId
        && lineIndex >= 0 && lineIndex < payload.items.size()
        && line.sourceProductId == receipt.sourceProductId
        && plan.sourceProductId == line.sourceProductId
        && plan.destinationProductId == productId
        && plan.destinationStockBefore == previous.stock
        && plan.destinationStockAfter >= previous.stock + line.quantity - 0.000001
        && plan.destinationStockAfter <= previous.stock + line.quantity + 0.000001
        && plan.destinationBatchIds is list
        && plan.destinationBatchIds.size() == line.batchAllocations.size()
        && receipt.receivedQuantity == line.quantity
        && receipt.damagedQuantity == 0
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'payload', 'deleted', 'updatedAt', 'updatedBy',
          'sourceShipmentId', 'sourceShipmentLineIndex'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'products'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceShipmentId == shipmentId
        && request.resource.data.sourceShipmentLineIndex == lineIndex
        && request.resource.data.payload.diff(previous).affectedKeys().hasOnly([
          'stock', 'name', 'sku', 'barcode', 'category', 'costPrice', 'retailPrice',
          'wholesalePrice', 'lowStockAt', 'unit', 'quantityMode'
        ])
        && product.id == productId
        && product.branchId == branchId
        && product.stock == plan.destinationStockAfter
        && product.name == line.productName
        && product.sku == (line.sku != '' ? line.sku : previous.sku)
        && product.barcode == (line.barcode != '' ? line.barcode : (previous.barcode is string ? previous.barcode : ''))
        && product.category == (line.category != '' ? line.category : previous.category)
        && product.costPrice >= (((previous.stock * previous.costPrice) + (line.quantity * line.costPrice)) / plan.destinationStockAfter) - 0.000001
        && product.costPrice <= (((previous.stock * previous.costPrice) + (line.quantity * line.costPrice)) / plan.destinationStockAfter) + 0.000001
        && product.retailPrice == line.retailPrice
        && product.wholesalePrice == line.wholesalePrice
        && product.lowStockAt == line.lowStockAt
        && product.unit == line.unit
        && product.quantityMode == line.quantityMode;
    }

    function validStockShipmentBatchCreate(businessId, branchId, batchId) {
      let shipmentId = request.resource.data.sourceShipmentId;
      let lineIndex = request.resource.data.sourceShipmentLineIndex;
      let batchIndex = request.resource.data.sourceShipmentBatchIndex;
      let shipmentPath = /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/stockShipments/$(shipmentId);
      let shipment = getAfter(shipmentPath).data;
      let payload = shipment.payload;
      let line = payload.items[lineIndex];
      let receipt = payload.receivedItems[lineIndex];
      let plan = payload.autoCompletionPlan[lineIndex];
      let allocation = line.batchAllocations[batchIndex];
      return isStockReceiverForBranch(businessId, branchId)
        && shipmentId is string
        && lineIndex is int
        && batchIndex is int
        && existsAfter(shipmentPath)
        && shipment.kind == 'stockShipments'
        && shipment.branchId == branchId
        && payload.status == 'approved'
        && payload.completionMode == 'auto'
        && payload.autoCompletedByUid == request.auth.uid
        && payload.toBranchId == branchId
        && lineIndex >= 0 && lineIndex < payload.items.size()
        && batchIndex >= 0 && batchIndex < line.batchAllocations.size()
        && line.sourceProductId == receipt.sourceProductId
        && receipt.receivedQuantity == line.quantity
        && receipt.damagedQuantity == 0
        && plan.sourceProductId == line.sourceProductId
        && plan.destinationBatchIds[batchIndex] == batchId
        && request.resource.data.payload.productId == plan.destinationProductId
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'payload', 'deleted', 'updatedAt', 'updatedBy',
          'sourceShipmentId', 'sourceShipmentLineIndex', 'sourceShipmentBatchIndex'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockBatches'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceShipmentId == shipmentId
        && request.resource.data.sourceShipmentLineIndex == lineIndex
        && request.resource.data.sourceShipmentBatchIndex == batchIndex
        && request.resource.data.payload is map
        && request.resource.data.payload.id == batchId
        && request.resource.data.payload.branchId == branchId
        && request.resource.data.payload.productId == plan.destinationProductId
        && request.resource.data.payload.stockReceiptId == shipmentId
        && request.resource.data.payload.quantity >= allocation.quantity - 0.000001
        && request.resource.data.payload.quantity <= allocation.quantity + 0.000001
        && request.resource.data.payload.unitCost == allocation.unitCost
        && request.resource.data.payload.expiryDate == allocation.expiryDate
        && request.resource.data.payload.purchaseId == allocation.purchaseId
        && request.resource.data.payload.supplierId == allocation.supplierId;
    }

    function validCashierSaleAuditCreate(businessId, branchId, eventId) {
      let saleId = request.resource.data.saleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'id', 'eventType', 'branchId', 'saleId', 'receiptNo', 'actorUid',
          'actorEmail', 'actorName', 'occurredAt', 'total'
        ])
        && request.resource.data.id == eventId
        && eventId == request.resource.data.saleId + '__created'
        && request.resource.data.eventType == 'SALE_CREATED'
        && request.resource.data.branchId == branchId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.saleId is string
        && request.resource.data.receiptNo is string
        && request.resource.data.occurredAt is string
        && request.resource.data.total is number
        && !exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.kind == 'sales'
        && getAfter(linkedSale).data.branchId == branchId
        && getAfter(linkedSale).data.payload.createdByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.status == 'completed';
    }

    function validOwnerVoidAuditCreate(businessId, branchId, eventId) {
      let linkedSale = salePath(businessId, branchId, request.resource.data.saleId);
      return isOwner(businessId)
        && request.resource.data.keys().hasOnly([
          'id', 'eventType', 'branchId', 'saleId', 'receiptNo', 'actorUid',
          'actorEmail', 'actorName', 'occurredAt', 'total', 'reason'
        ])
        && request.resource.data.id == eventId
        && eventId == request.resource.data.saleId + '__void'
        && request.resource.data.eventType == 'SALE_VOIDED'
        && request.resource.data.branchId == branchId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.payload.status == 'voided'
        && getAfter(linkedSale).data.payload.voidedByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.voidReason == request.resource.data.reason;
    }


    function validCashierMember(memberId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'branchIds',
          'status', 'createdAt', 'updatedAt', 'createdBy', 'canReceiveStock'
        ])
        && request.resource.data.uid == memberId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'cashier'
        && request.resource.data.status == 'active'
        && request.resource.data.branchIds is list
        && request.resource.data.branchIds.size() == 1
        && request.resource.data.createdBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['canReceiveStock']) || request.resource.data.canReceiveStock is bool);
    }

    function validCashierSaleCreate(businessId, branchId, saleId) {
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'deleted', 'updatedAt', 'updatedBy', 'payload'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'sales'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && request.resource.data.payload is map
        && request.resource.data.payload.id == saleId
        && request.resource.data.payload.branchId == branchId
        && request.resource.data.payload.createdByUid == request.auth.uid
        && request.resource.data.payload.status == 'completed'
        && request.resource.data.payload.receiptNo is string
        && request.resource.data.payload.items is list
        && request.resource.data.payload.items.size() > 0
        && request.resource.data.payload.total is number
        && request.resource.data.payload.total >= 0
        && request.resource.data.payload.paymentMethod in ['Cash', 'KPay', 'Credit']
        && (request.resource.data.payload.paymentMethod != 'KPay'
          || (request.resource.data.payload.kpayTransactionReference is string
            && request.resource.data.payload.kpayTransactionReference.size() > 0
            && branchHasConfiguredKPay(businessId, branchId)))
        && request.resource.data.payload.productDeltas is map
        && request.resource.data.payload.productDeltas.keys().size() > 0
        && request.resource.data.payload.stockLines is list
        && request.resource.data.payload.stockLines.size() == request.resource.data.payload.productDeltas.keys().size()
        && request.resource.data.payload.batchDeltas is map
        && request.resource.data.payload.batchLines is list
        && request.resource.data.payload.batchLines.size() == request.resource.data.payload.batchDeltas.keys().size()
        && request.resource.data.payload.cashierSyncVersion == 1;
    }

    // A Cashier may only reduce stock as part of the same atomic transaction
    // that creates a new Sale. A replay cannot decrement stock a second time.
    // Cashier expense records are reports of spending already made.
    // Owner approval/acknowledgement is not required.
    function validCashierExpenseCreate(businessId, branchId, expenseId) {
      let payload = request.resource.data.payload;
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'deleted', 'updatedAt', 'updatedBy', 'payload'
        ])
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'expenses'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string
        && payload is map
        && payload.keys().hasOnly([
          'id', 'branchId', 'title', 'category', 'amount', 'date', 'note',
          'createdByUid', 'createdByEmail', 'createdByName', 'createdByRole', 'fundedBy',
          'paymentMethod', 'approvalStatus', 'reviewStatus', 'submittedAt',
          'updatedAt', 'updatedByUid'
        ])
        && payload.id == expenseId
        && payload.branchId == branchId
        && payload.title is string
        && payload.title.size() > 0
        && payload.category is string
        && payload.amount is number
        && payload.amount > 0
        && payload.date is string
        && payload.note is string
        && payload.createdByUid == request.auth.uid
        && payload.createdByEmail is string
        && payload.createdByName is string
        && (!payload.keys().hasAny(['createdByRole']) || payload.createdByRole == 'cashier')
        && payload.fundedBy in ['cashier-personal', 'branch-cash', 'branch-kpay']
        && payload.paymentMethod in ['cash', 'kpay']
        && (payload.fundedBy != 'branch-cash' || payload.paymentMethod == 'cash')
        && (payload.fundedBy != 'branch-kpay' || payload.paymentMethod == 'kpay')
        && payload.approvalStatus in ['pending', 'not-required']
        && (!payload.keys().hasAny(['reviewStatus']) || payload.reviewStatus == 'submitted')
        && (!payload.keys().hasAny(['submittedAt']) || payload.submittedAt is string)
        && payload.updatedAt is string
        && payload.updatedByUid == request.auth.uid;
    }

    function linkedProductStockReduction(businessId, branchId, productId) {
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let reduction = resource.data.payload.stock - request.resource.data.payload.stock;
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'products'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'products'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['stock'])
        && resource.data.payload.stock is number
        && request.resource.data.payload.stock is number
        && reduction > 0
        && request.resource.data.payload.stock >= 0
        && !exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.kind == 'sales'
        && getAfter(linkedSale).data.branchId == branchId
        && getAfter(linkedSale).data.updatedBy == request.auth.uid
        && getAfter(linkedSale).data.payload.createdByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.status == 'completed'
        && getAfter(linkedSale).data.payload.productDeltas[productId] == reduction
        && getAfter(linkedSale).data.payload.stockLines.hasAny([
          { 'productId': productId, 'quantity': reduction }
        ]);
    }

    function linkedBatchStockReduction(businessId, branchId, batchId) {
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      let reduction = resource.data.payload.quantity - request.resource.data.payload.quantity;
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'stockBatches'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockBatches'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['quantity'])
        && resource.data.payload.quantity is number
        && request.resource.data.payload.quantity is number
        && reduction > 0
        && request.resource.data.payload.quantity >= 0
        && !exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.kind == 'sales'
        && getAfter(linkedSale).data.branchId == branchId
        && getAfter(linkedSale).data.updatedBy == request.auth.uid
        && getAfter(linkedSale).data.payload.createdByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.status == 'completed'
        && getAfter(linkedSale).data.payload.batchDeltas[batchId] == reduction
        && getAfter(linkedSale).data.payload.batchLines.hasAny([
          { 'batchId': batchId, 'quantity': reduction }
        ]);
    }

    // Cashier may mark registered barcode units sold only in the same
    // transaction that creates the linked Sale for this exact Branch.
    function linkedStockUnitSaleUpdate(businessId, branchId, registryId) {
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      return isCashierForBranch(businessId, branchId)
        && resource.data.kind == 'stockUnitRegistries'
        && resource.data.branchId == branchId
        && resource.data.deleted != true
        && resource.data.payload is map
        && request.resource.data.scope == 'branchRecord'
        && request.resource.data.kind == 'stockUnitRegistries'
        && request.resource.data.branchId == branchId
        && request.resource.data.deleted == false
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.payload is map
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly([
          'units', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.payload.productId == resource.data.payload.productId
        && request.resource.data.payload.branchId == branchId
        && request.resource.data.payload.units is list
        && resource.data.payload.units is list
        && request.resource.data.payload.units.size() == resource.data.payload.units.size()
        && !exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.kind == 'sales'
        && getAfter(linkedSale).data.branchId == branchId
        && getAfter(linkedSale).data.updatedBy == request.auth.uid
        && getAfter(linkedSale).data.payload.createdByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.status == 'completed'
        && getAfter(linkedSale).data.payload.stockUnitRegistryIds is list
        && getAfter(linkedSale).data.payload.stockUnitRegistryIds.hasAny([registryId]);
    }

    function validCashierCustomerCreate(businessId, recordId) {
      let branchId = request.resource.data.branchId;
      let saleId = request.resource.data.sourceSaleId;
      let linkedSale = salePath(businessId, branchId, saleId);
      return isCashierForBranch(businessId, branchId)
        && request.resource.data.keys().hasOnly([
          'scope', 'kind', 'branchId', 'payload', 'updatedAt', 'updatedBy', 'sourceSaleId'
        ])
        && request.resource.data.scope == 'shared'
        && request.resource.data.kind == 'customers'
        && request.resource.data.payload is map
        && request.resource.data.payload.id == recordId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.sourceSaleId is string
        && !exists(linkedSale)
        && existsAfter(linkedSale)
        && getAfter(linkedSale).data.kind == 'sales'
        && getAfter(linkedSale).data.updatedBy == request.auth.uid
        && getAfter(linkedSale).data.payload.createdByUid == request.auth.uid
        && getAfter(linkedSale).data.payload.paymentMethod == 'Credit'
        && getAfter(linkedSale).data.payload.customerId == recordId
        && getAfter(linkedSale).data.payload.customerSnapshot.id == recordId;
    }

    match /businesses/{businessId} {
      allow get: if isBusinessOwner(businessId) || isActiveMember(businessId);
      allow list: if false;

      allow create: if isConfiguredOwner(businessId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
      allow update: if isConfiguredOwner(businessId)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{memberId} {
        allow get: if (signedIn() && request.auth.uid == memberId) || isOwner(businessId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && validCashierMember(memberId);
        allow update: if isOwner(businessId)
          && resource.data.role == 'cashier'
          && request.resource.data.role == 'cashier'
          && request.resource.data.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'branchIds', 'status', 'updatedAt', 'canReceiveStock'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['canReceiveStock']) || request.resource.data.canReceiveStock is bool)
          && request.resource.data.branchIds is list
          && request.resource.data.branchIds.size() == 1;
        allow delete: if isOwner(businessId) && resource.data.role == 'cashier';
      }

      match /branches/{branchId} {
        allow get: if isOwner(businessId) || isCashierForBranch(businessId, branchId);
        allow list: if isOwner(businessId);
        allow create, update, delete: if isOwner(businessId);

        match /{collectionName}/{recordId} {
          allow get: if isOwner(businessId)
            || (isCashierForBranch(businessId, branchId)
              && (collectionName in ['categories', 'products', 'stockBatches', 'stockUnitRegistries']
                || (collectionName == 'stockShipments' && isStockReceiverForBranch(businessId, branchId))
                || (collectionName == 'expenses'
                  && (!exists(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/expenses/$(recordId))
                    || resource.data.payload.createdByUid == request.auth.uid))
                || (collectionName == 'cashierSettlements'
                  && resource.data.payload.cashierUid == request.auth.uid)
                || (collectionName == 'sales'
                  && (!exists(salePath(businessId, branchId, recordId))
                    || (resource.data.payload.createdByUid == request.auth.uid
                      && resource.data.payload.branchId == branchId)))
                || (collectionName == 'auditEvents'
                  && (!exists(/databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)/auditEvents/$(recordId))
                    || resource.data.actorUid == request.auth.uid))));

          allow list: if isOwner(businessId)
            || (isCashierForBranch(businessId, branchId)
              && (collectionName in ['categories', 'products', 'stockBatches', 'stockUnitRegistries']
                || (collectionName == 'stockShipments' && isStockReceiverForBranch(businessId, branchId))
                || (collectionName == 'expenses'
                  && request.query.limit <= 100
                  && resource.data.payload.createdByUid == request.auth.uid)
                || (collectionName == 'cashierSettlements'
                  && request.query.limit <= 100
                  && resource.data.payload.cashierUid == request.auth.uid)
                || (collectionName == 'sales'
                  && request.query.limit <= 100
                  && resource.data.payload.createdByUid == request.auth.uid)));

          allow create: if (isOwner(businessId) && collectionName != 'auditEvents')
            || (collectionName == 'sales' && validCashierSaleCreate(businessId, branchId, recordId))
            || (collectionName == 'expenses' && validCashierExpenseCreate(businessId, branchId, recordId))
            || (collectionName == 'products' && validStockShipmentProductCreate(businessId, branchId, recordId))
            || (collectionName == 'stockBatches' && validStockShipmentBatchCreate(businessId, branchId, recordId))
            || (collectionName == 'auditEvents' && (validCashierSaleAuditCreate(businessId, branchId, recordId)
              || validOwnerVoidAuditCreate(businessId, branchId, recordId)));

          allow update: if (isOwner(businessId) && collectionName != 'auditEvents' && collectionName != 'branchFinanceReconciliations')
            || (collectionName == 'stockShipments' && (validStockShipmentReceiptUpdate(businessId, branchId) || validStockShipmentAutoCompleteUpdate(businessId, branchId)))
            || (collectionName == 'products' && (linkedProductStockReduction(businessId, branchId, recordId) || validStockShipmentProductUpdate(businessId, branchId, recordId)))
            || (collectionName == 'stockBatches' && linkedBatchStockReduction(businessId, branchId, recordId))
            || (collectionName == 'stockUnitRegistries' && linkedStockUnitSaleUpdate(businessId, branchId, recordId));

          allow delete: if isOwner(businessId) && collectionName != 'auditEvents' && collectionName != 'branchFinanceReconciliations';
        }
      }

      match /shared/{collectionName}/{recordId} {
        allow read, write: if isOwner(businessId);
      }

      match /shared/{collectionName}/records/{recordId} {
        allow get: if isOwner(businessId) || isActiveMember(businessId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId)
          || (collectionName == 'customers' && validCashierCustomerCreate(businessId, recordId));
        allow update, delete: if isOwner(businessId);
      }

      match /meta/{metaId} {
        allow read, write: if isOwner(businessId);
      }
    }

    // Per-user legacy POS data remains private to its authenticated user.
    match /posAccounts/{userId}/posRecords/{recordId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /posAccounts/{userId}/posMeta/{metaId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // All unspecified paths remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
